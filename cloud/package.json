{
  "name": "har-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "cd ../webapp && npm run build -- --mode cloudflare",
    "dev": "wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply har-db --local",
    "db:migrate": "wrangler d1 migrations apply har-db --remote",
    "admin": "node scripts/admin.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "typescript": "5.6.3",
    "wrangler": "4.158.0"
  }
}
