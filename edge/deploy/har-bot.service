[Unit]
Description=HAR bot – nhận lệnh Telegram (trạng thái, thống kê, còi)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/har/edge
ExecStart=/home/pi/har/edge/.venv/bin/python -m har_edge.bot
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
