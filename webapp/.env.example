# Copy thành .env.local khi chạy dev.
# mock: dữ liệu mẫu trong trình duyệt (làm giao diện trước khi có API)
# api : gọi backend; trên VPS dùng VITE_API_URL=/api (cùng tên miền)
VITE_DATA_SOURCE=mock
VITE_API_URL=http://localhost:8000/api
# Link dataset (Google Drive) hiển thị ở trang Đánh giá model, có thể để trống
VITE_DATASET_URL=
